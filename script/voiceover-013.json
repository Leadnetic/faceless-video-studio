  "id": "psychology-video-013",
  "title": "The Bunker (Part 1)",
  "voice": {
    "engine": "kokoro-onnx v1.0 (local)",
    "voice": "af_heart",
    "speed": 1.04,
    "pitchShift": 1.0,
    "dry": true
  },
