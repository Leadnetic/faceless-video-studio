    }
  },
  "lines": [
    {
      "speaker": "pa",
      "text": "Warning. Bunker doors closing in ten seconds.",
      "pause": 0.2,
      "emphasis": [
        "ten"
      ]
    },
    {
      "speaker": "reader",
      "text": "The world is ending. You can take one thing inside.",
      "pause": 0.25,
      "emphasis": [
        "one"
      ]
    },
    {
      "speaker": "reader",
      "text": "A, a first-aid kit. B, food and water. C, a radio. D, a photo of someone you love.",
      "pause": 0.3,
      "emphasis": [
        "A,",
        "B,",
        "C,",
        "D,"
      ]
    },
    {
      "speaker": "reader",
      "text": "Don't think. Pick.",
      "pause": 0.3,
      "emphasis": [
        "Pick."
      ]
    },
    {
      "speaker": "pa",
      "text": "Three. Two. One.",
      "say": "Three... Two... One.",
      "pause": 0.9,
      "emphasis": [
        "One."
      ]
    },
    {
      "speaker": "reader",
      "text": "Done? Good.",
      "pause": 0.35,
      "emphasis": [
        "Good."
      ]
    },
    {
      "speaker": "reader",
      "text": "What you grab in a panic shows how your brain handles fear.",
      "pause": 0.25,
      "emphasis": [
        "panic",
        "fear."
      ]
    },
    {
      "speaker": "reader",
      "text": "Two of these protect your body. Two of them protect something else.",
      "pause": 0.35,
      "emphasis": [
        "body.",
        "else."
      ]
    },
    {
      "speaker": "reader",
      "text": "Comment your letter. In part two, I'll read you.",
      "pause": 0.2,
      "emphasis": [
        "letter.",
        "two,"
      ]
    }
  ]
}